{
  "name": "numeric for generates repeated same-named sibling nodes",
  "source": "for i = 1, 3 do\n    server {\n        name = node-$i\n        index = i\n    }\nend",
  "expect": {
    "type": "entries",
    "value": [
      {
        "kind": "node", "name": "server", "header": null,
        "children": [
          { "kind": "leaf", "key": "name", "value": { "type": "string", "value": "node-1" } },
          { "kind": "leaf", "key": "index", "value": { "type": "int", "value": "1" } }
        ]
      },
      {
        "kind": "node", "name": "server", "header": null,
        "children": [
          { "kind": "leaf", "key": "name", "value": { "type": "string", "value": "node-2" } },
          { "kind": "leaf", "key": "index", "value": { "type": "int", "value": "2" } }
        ]
      },
      {
        "kind": "node", "name": "server", "header": null,
        "children": [
          { "kind": "leaf", "key": "name", "value": { "type": "string", "value": "node-3" } },
          { "kind": "leaf", "key": "index", "value": { "type": "int", "value": "3" } }
        ]
      }
    ]
  }
}
