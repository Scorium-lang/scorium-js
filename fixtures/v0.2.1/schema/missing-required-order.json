{
  "name": "missing required schema keys are deterministic",
  "source": "server {\n}\n",
  "schema": {
    "nodes": {
      "server": {
        "keys": {
          "port": { "type": "integer", "required": true },
          "host": { "type": "string", "required": true }
        }
      }
    }
  },
  "expect_errors": [
    { "code": "scorium::schema::missing_required_key", "node": "server", "key": "host" },
    { "code": "scorium::schema::missing_required_key", "node": "server", "key": "port" }
  ]
}
